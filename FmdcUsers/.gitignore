## Merged .gitignore for .NET / Visual Studio / ASP.NET Core Projects
## Base: github/gitignore VisualStudio template
## Additions: .env, secrets.json, dist/, coverage/, *.temp, *.swp, vim swaps
##
## Get latest VS base from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# =====================================================================
# USER-SPECIFIC FILES
# =====================================================================

# Visual Studio
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# MonoDevelop / Xamarin Studio
*.userprefs

# Mono auto generated files
mono_crash.*

# =====================================================================
# BUILD RESULTS
# =====================================================================

[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# =====================================================================
# VISUAL STUDIO CACHE / OPTIONS
# =====================================================================

.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2017 auto generated files
Generated\ Files/

# =====================================================================
# TEST RESULTS
# =====================================================================

# MSTest
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# Benchmark Results
BenchmarkDotNet.Artifacts/

# =====================================================================
# .NET / ASP.NET CORE
# =====================================================================

project.lock.json
project.fragment.lock.json
artifacts/
ScaffoldingReadMe.txt

# =====================================================================
# CODE ANALYSIS / COVERAGE
# =====================================================================

# StyleCop
StyleCopReport.xml

# Coverlet
coverage*.json
coverage*.xml
coverage*.info

# Visual Studio coverage
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# AxoCover
.axoCover/*
!.axoCover/settings.json

# Coverage directory (e.g. ReportGenerator output)
coverage/

# MightyMoose
*.mm.*
AutoTest.Net/

# OpenCover UI
OpenCover/

