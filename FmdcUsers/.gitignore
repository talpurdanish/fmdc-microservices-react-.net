*.tmp
*.temp
*.swp
*.cache
*~
*.bak
*.backup
*.autosave

# Chutzpah
_Chutzpah*

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

